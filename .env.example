# Postgres hébergé. Sur Vercel (serverless), garder connection_limit=1 :
# le fournisseur refuse les connexions au-delà de son quota
# ("FATAL: sorry, too many clients already").
DATABASE_URL="postgres://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require&connection_limit=1"

# openssl rand -base64 32
AUTH_SECRET=""

# NE PAS définir AUTH_URL sur Vercel : avec trustHost, l'hôte est déduit de la
# requête. Une valeur figée renverrait toutes les redirections sur ce domaine.

# Stockage des photos avant/après (Vercel → Storage → Blob).
# Sans jeton, l'application refuse l'envoi en production plutôt que d'écrire
# sur un disque en lecture seule.
BLOB_READ_WRITE_TOKEN=""
