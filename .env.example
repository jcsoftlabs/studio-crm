# Postgres hébergé. Sur Vercel (serverless), ajouter connection_limit=1 :
# le fournisseur refuse les connexions au-delà de son quota
# ("FATAL: sorry, too many clients already").
DATABASE_URL="postgres://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require&connection_limit=1"
AUTH_SECRET=""
AUTH_URL="http://localhost:3000"

# Stockage des photos avant/après. Sans jeton, repli sur le disque local
# (effacé à chaque déploiement Vercel).
BLOB_READ_WRITE_TOKEN=""
