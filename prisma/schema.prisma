generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  OWNER
  RECEPTION
  STYLIST
}

enum AppLocale {
  es
  fr
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  name         String
  role         Role      @default(STYLIST)
  locale       AppLocale @default(es)
  active       Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  auditLogs AuditLog[]
  employee  Employee?

  @@index([deletedAt])
}

/// Ligne unique (id = "singleton"). Toutes les informations du studio sont
/// modifiables depuis Paramètres : rien n'est codé en dur ni lu dans l'environnement.
model StudioSettings {
  id String @id @default("singleton")

  name        String  @default("")
  legalName   String  @default("")
  rnc         String  @default("")
  address     String  @default("")
  city        String  @default("")
  province    String  @default("")
  phone       String  @default("")
  whatsapp    String  @default("")
  email       String  @default("")
  website     String  @default("")
  logoUrl     String?

  currencyCode   String @default("DOP")
  currencySymbol String @default("RD$")
  showUsd        Boolean @default(false)
  usdRateCents   Int?

  /// ITBIS en points de base : 1800 = 18,00 %. Entier, jamais de Float (§3.3).
  itbisRateBp             Int @default(1800)
  defaultCommissionRateBp Int @default(0)

  timezone      String    @default("America/Santo_Domingo")
  defaultLocale AppLocale @default(es)

  invoiceFooterEs String @default("")
  invoiceFooterFr String @default("")
  printerWidthMm  Int    @default(80)

  ncfLowThreshold      Int @default(50)
  ncfExpiryWarningDays Int @default(30)

  /// Le studio peut encaisser avant d'avoir ses séquences DGII. À désactiver
  /// dès que l'enregistrement est finalisé.
  allowSalesWithoutNcf Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  businessHours BusinessHours[]
}

model BusinessHours {
  id       String @id @default(cuid())
  settings StudioSettings @relation(fields: [settingsId], references: [id], onDelete: Cascade)
  settingsId String @default("singleton")

  /// 0 = dimanche … 6 = samedi
  weekday Int
  closed  Boolean @default(false)
  /// Minutes depuis minuit, heure locale du studio
  openMinute  Int @default(540)
  closeMinute Int @default(1080)

  @@unique([settingsId, weekday])
}

model AuditLog {
  id       String   @id @default(cuid())
  user     User?    @relation(fields: [userId], references: [id])
  userId   String?
  action   String
  entity   String
  entityId String?
  before   Json?
  after    Json?
  createdAt DateTime @default(now())

  @@index([entity, entityId])
  @@index([createdAt])
}

enum PhotoType {
  BEFORE
  AFTER
}

model Client {
  id        String    @id @default(cuid())
  firstName String
  /// Optionnel : une cliente de passage se saisit avec un prénom et un numéro.
  lastName  String    @default("")
  phone     String    @default("")
  email     String?
  birthDate DateTime?

  notes       String @default("")
  allergies   String @default("")
  preferences String @default("")

  /// Langue des messages envoyés à la cliente (§3.1), indépendante de l'interface.
  locale AppLocale @default(es)

  /// Colonnes dérivées, maintenues à l'écriture : recherche sans accent ni format.
  searchName  String @default("")
  phoneDigits String @default("")

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  photos       ClientPhoto[]
  appointments Appointment[]
  waitlist     WaitlistEntry[]
  invoices     Invoice[]
  packages     ClientPackage[]
  giftCards    GiftCard[]

  @@index([searchName])
  @@index([phoneDigits])
  @@index([deletedAt])
}

model ClientPhoto {
  id       String @id @default(cuid())
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  clientId String

  url        String
  storageKey String
  type       PhotoType
  /// Renseigné à partir de la phase 2 (agenda).
  appointmentId String?
  takenAt    DateTime @default(now())
  createdAt  DateTime @default(now())

  @@index([clientId, takenAt])
}

model ServiceCategory {
  id     String @id @default(cuid())
  nameEs String
  nameFr String
  order  Int    @default(0)
  active Boolean @default(true)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  services Service[]

  @@index([order])
}

model Service {
  id         String          @id @default(cuid())
  category   ServiceCategory @relation(fields: [categoryId], references: [id])
  categoryId String

  nameEs      String
  nameFr      String
  durationMin Int
  priceCents  Int
  /// Points de base ; null = on retombe sur le taux de l'employée puis sur celui des Paramètres.
  commissionRateBp Int?
  order       Int     @default(0)
  active      Boolean @default(true)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  appointmentItems AppointmentItem[]
  waitlist         WaitlistEntry[]
  invoiceLines     InvoiceLine[]

  @@index([categoryId, order])
}

model Package {
  id            String  @id @default(cuid())
  clientPackages ClientPackage[]
  invoiceLines   InvoiceLine[]
  nameEs        String
  nameFr        String
  priceCents    Int
  sessionsTotal Int
  validityDays  Int
  active        Boolean @default(true)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
}


enum AppointmentStatus {
  SCHEDULED
  CONFIRMED
  IN_PROGRESS
  DONE
  NO_SHOW
  CANCELLED
}

enum AppointmentSource {
  WALK_IN
  PHONE
  ONLINE
}

model Employee {
  id     String  @id @default(cuid())
  user   User?   @relation(fields: [userId], references: [id])
  userId String? @unique

  name   String
  phone  String  @default("")
  /// Couleur de la colonne et des blocs dans l'agenda.
  color  String  @default("#c084fc")
  active Boolean @default(true)
  order  Int     @default(0)

  /// Rémunération, paramétrée par la propriétaire (§7.2).
  salaryType      SalaryType @default(COMMISSION)
  baseSalaryCents Int        @default(0)
  /// Points de base. Null = on retombe sur le taux des Paramètres.
  commissionRateBp Int?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  schedules        EmployeeSchedule[]
  timeOff          TimeOff[]
  appointments     Appointment[]
  appointmentItems AppointmentItem[]
  waitlist         WaitlistEntry[]
  cashSessions     CashSession[]
  invoiceLines     InvoiceLine[]
  commissions      Commission[]
  stockMovements   StockMovement[]

  @@index([deletedAt, order])
}

model EmployeeSchedule {
  id         String   @id @default(cuid())
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  employeeId String

  /// 0 = dimanche … 6 = samedi
  weekday     Int
  closed      Boolean @default(false)
  openMinute  Int     @default(540)
  closeMinute Int     @default(1080)

  @@unique([employeeId, weekday])
}

model TimeOff {
  id         String   @id @default(cuid())
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  employeeId String

  startAt DateTime
  endAt   DateTime
  reason  String   @default("")

  createdAt DateTime @default(now())

  @@index([employeeId, startAt])
}

model Appointment {
  id         String   @id @default(cuid())
  client     Client   @relation(fields: [clientId], references: [id])
  clientId   String
  employee   Employee @relation(fields: [employeeId], references: [id])
  employeeId String

  startAt DateTime
  endAt   DateTime
  status  AppointmentStatus @default(SCHEDULED)
  source  AppointmentSource @default(WALK_IN)
  notes   String            @default("")

  createdBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items    AppointmentItem[]
  invoices Invoice[]

  @@index([employeeId, startAt])
  @@index([startAt])
  @@index([clientId, startAt])
}

model AppointmentItem {
  id            String      @id @default(cuid())
  appointment   Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  appointmentId String
  service       Service     @relation(fields: [serviceId], references: [id])
  serviceId     String
  employee      Employee    @relation(fields: [employeeId], references: [id])
  employeeId    String

  /// Repris du service à la création, puis modifiables sur le rendez-vous.
  priceCents  Int
  durationMin Int
  order       Int @default(0)

  @@index([appointmentId, order])
}

model WaitlistEntry {
  id         String    @id @default(cuid())
  client     Client    @relation(fields: [clientId], references: [id])
  clientId   String
  service    Service?  @relation(fields: [serviceId], references: [id])
  serviceId  String?
  employee   Employee? @relation(fields: [employeeId], references: [id])
  employeeId String?

  note          String    @default("")
  preferredFrom DateTime?
  preferredTo   DateTime?
  resolvedAt    DateTime?

  createdAt DateTime @default(now())

  @@index([resolvedAt, createdAt])
}


enum NcfType {
  B01
  B02
  E_CF
}

enum InvoiceStatus {
  ISSUED
  VOIDED
}

enum PaymentMethod {
  CASH
  CARD
  TRANSFER
  GIFT_CARD
  PACKAGE
}

enum CashMovementType {
  IN
  OUT
}

/// Séquence de comprobantes fiscaux délivrée par la DGII.
model NcfSequence {
  id     String  @id @default(cuid())
  type   NcfType
  prefix String
  /// Dernier numéro attribué. Incrémenté sous verrou, jamais par un count().
  currentNumber Int
  maxNumber     Int
  expiresAt     DateTime?
  active        Boolean   @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  invoices Invoice[]

  @@index([type, active])
}

model Invoice {
  id            String       @id @default(cuid())
  client        Client?      @relation(fields: [clientId], references: [id])
  clientId      String?
  appointment   Appointment? @relation(fields: [appointmentId], references: [id])
  appointmentId String?

  /// Numéro interne, présent sur tout document, avec ou sans NCF.
  number Int @unique @default(autoincrement())

  /// Nul tant que la DGII n'a pas délivré de séquence : le document est alors un
  /// reçu sans valeur fiscale. Unique quand il est renseigné (Postgres traite les
  /// NULL comme distincts), deux factures ne portent jamais le même comprobante.
  ncf        String?      @unique
  ncfType    NcfType?
  sequence   NcfSequence? @relation(fields: [sequenceId], references: [id])
  sequenceId String?

  subtotalCents Int
  discountCents Int @default(0)
  itbisCents    Int
  totalCents    Int
  /// Taux figé à l'émission : une facture ne change pas si l'ITBIS change ensuite.
  itbisRateBp   Int

  status     InvoiceStatus @default(ISSUED)
  issuedAt   DateTime      @default(now())
  voidedAt   DateTime?
  voidReason String?

  /// Langue de la cliente, pour l'impression et le message WhatsApp.
  locale AppLocale @default(es)

  cashSession   CashSession? @relation(fields: [cashSessionId], references: [id])
  cashSessionId String?

  createdBy String?
  createdAt DateTime @default(now())

  lines       InvoiceLine[]
  payments    Payment[]
  commissions Commission[]
  stockMovements StockMovement[]
  clientPackages ClientPackage[]

  @@index([issuedAt])
  @@index([clientId, issuedAt])
  @@index([cashSessionId])
}

model InvoiceLine {
  id        String  @id @default(cuid())
  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  invoiceId String

  service   Service? @relation(fields: [serviceId], references: [id])
  serviceId String?
  product   Product? @relation(fields: [productId], references: [id])
  productId String?
  package   Package? @relation(fields: [packageId], references: [id])
  packageId String?
  employee  Employee? @relation(fields: [employeeId], references: [id])
  employeeId String?

  description    String
  quantity       Int @default(1)
  unitPriceCents Int
  discountCents  Int @default(0)
  totalCents     Int
  order          Int @default(0)

  @@index([invoiceId, order])
}

model Payment {
  id        String  @id @default(cuid())
  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  invoiceId String

  method     PaymentMethod
  amountCents Int
  reference  String?

  giftCard   GiftCard? @relation(fields: [giftCardId], references: [id])
  giftCardId String?
  /// Forfait dont une séance a été consommée, pour pouvoir la rendre à l'annulation.
  clientPackage   ClientPackage? @relation(fields: [clientPackageId], references: [id])
  clientPackageId String?

  createdAt DateTime @default(now())

  @@index([invoiceId])
}

model CashSession {
  id         String   @id @default(cuid())
  employee   Employee @relation(fields: [employeeId], references: [id])
  employeeId String

  openedAt  DateTime  @default(now())
  closedAt  DateTime?
  openedBy  String?
  closedBy  String?

  openingCents    Int
  countedCents    Int?
  expectedCents   Int?
  differenceCents Int?

  movements CashMovement[]
  invoices  Invoice[]

  @@index([closedAt, openedAt])
}

model CashMovement {
  id            String      @id @default(cuid())
  cashSession   CashSession @relation(fields: [cashSessionId], references: [id], onDelete: Cascade)
  cashSessionId String

  type        CashMovementType
  amountCents Int
  reason      String           @default("")
  createdBy   String?
  createdAt   DateTime         @default(now())

  @@index([cashSessionId])
}

model ClientPackage {
  id        String  @id @default(cuid())
  client    Client  @relation(fields: [clientId], references: [id])
  clientId  String
  package   Package @relation(fields: [packageId], references: [id])
  packageId String

  sessionsUsed Int      @default(0)
  expiresAt    DateTime
  createdAt    DateTime @default(now())

  /// Facture d'achat du forfait, pour la traçabilité.
  invoice   Invoice? @relation(fields: [invoiceId], references: [id])
  invoiceId String?
  payments  Payment[]

  @@index([clientId, expiresAt])
}

model GiftCard {
  id       String  @id @default(cuid())
  code     String  @unique
  client   Client? @relation(fields: [clientId], references: [id])
  clientId String?

  amountCents  Int
  balanceCents Int
  expiresAt    DateTime?
  active       Boolean   @default(true)

  createdAt DateTime @default(now())
  payments  Payment[]
}


enum SalaryType {
  COMMISSION
  FIXED
  BOOTH_RENT
}

enum StockMovementType {
  PURCHASE
  SALE
  INTERNAL_USE
  ADJUSTMENT
}

/// Une ligne par prestation facturée : le détail permet de justifier le règlement.
model Commission {
  id         String   @id @default(cuid())
  employee   Employee @relation(fields: [employeeId], references: [id])
  employeeId String
  invoice    Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  invoiceId  String

  /// Assiette : total de la ligne, remise déduite, hors ITBIS.
  baseCents   Int
  rateBp      Int
  amountCents Int

  paidAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([employeeId, paidAt])
  @@index([invoiceId])
}

model Supplier {
  id    String @id @default(cuid())
  name  String
  phone String @default("")
  notes String @default("")

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  products Product[]
}

model Product {
  id   String @id @default(cuid())
  name String
  sku  String @default("")

  costCents  Int @default(0)
  priceCents Int @default(0)

  stockQty    Int @default(0)
  minStockQty Int @default(0)

  /// Faux = produit de cabine, consommé en interne et jamais vendu.
  forResale Boolean @default(true)
  active    Boolean @default(true)

  supplier   Supplier? @relation(fields: [supplierId], references: [id])
  supplierId String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  movements    StockMovement[]
  invoiceLines InvoiceLine[]

  @@index([deletedAt, name])
}

model StockMovement {
  id        String  @id @default(cuid())
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId String

  type StockMovementType
  /// Positif pour une entrée, négatif pour une sortie.
  qty    Int
  reason String @default("")

  invoice    Invoice?  @relation(fields: [invoiceId], references: [id])
  invoiceId  String?
  employee   Employee? @relation(fields: [employeeId], references: [id])
  employeeId String?

  createdBy String?
  createdAt DateTime @default(now())

  @@index([productId, createdAt])
}
